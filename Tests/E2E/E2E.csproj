<Project Sdk="Microsoft.NET.Sdk">
  <!-- End-to-end client: the REAL ClientPortalApi / PortalReleaseSource / ProductSession against a local test server.
       Driven by website/e2e.loader.test.mjs (LB_PORTAL_URL must be a loopback address; see ClientPortalApi.ResolvePortalUrl). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Classes/ClientPortalApi.cs" Link="ClientPortalApi.cs" />
    <Compile Include="../../Classes/DeviceIdentity.cs" Link="DeviceIdentity.cs" />
    <Compile Include="../../Classes/Platform/ReleaseManifest.cs" Link="Platform/ReleaseManifest.cs" />
    <Compile Include="../../Classes/Platform/ReleaseTrust.cs" Link="Platform/ReleaseTrust.cs" />
    <Compile Include="../../Classes/Platform/ReleaseWorkspace.cs" Link="Platform/ReleaseWorkspace.cs" />
    <Compile Include="../../Classes/Platform/ProductSession.cs" Link="Platform/ProductSession.cs" />
    <Compile Include="../../Classes/Platform/PortalReleaseSource.cs" Link="Platform/PortalReleaseSource.cs" />
  </ItemGroup>
</Project>
