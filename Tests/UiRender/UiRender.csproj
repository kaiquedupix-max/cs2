<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renders the real ProductSelectionForm with catalog data shaped like the server's answer and saves PNGs.
       Usage: dotnet run with the project Tests/UiRender, Release, and the output folder as the only argument -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AssemblyName>UiRender</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Mac1ota Menu.csproj" />
  </ItemGroup>
</Project>
